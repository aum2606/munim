# Copy to .env.production on the server; never commit real values.
APP_ENV=prod
APP_DOMAIN=
TLS_EMAIL=
SECRET_KEY=
# URL-encode the password in DATABASE_URL; use the same value as POSTGRES_PASSWORD.
POSTGRES_PASSWORD=
DATABASE_URL=
REDIS_URL=redis://redis:6379/0
PUBLIC_API_URL=
WIDGET_SCRIPT_URL=
CORS_ORIGINS=
STORAGE_DIR=/data/uploads
CREDENTIALS_ENCRYPTION_KEY=
PRIVACY_HASH_KEY=
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL_ROUTER=
LLM_MODEL_REASONING=
LLM_MODEL_CHEAP=
EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_MODEL=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=
RATE_LIMITS_ENABLED=true
# Only for isolated staging checks; leave false for the pilot.
ALLOW_FAKE_MODELS_IN_PROD=false
# Prefer an instance/workload IAM role. Otherwise use narrowly scoped private bucket credentials.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1
BACKUP_BUCKET=
BACKUP_PREFIX=munim
BACKUP_ENDPOINT_URL=
BACKUP_SSE=AES256
BACKUP_KMS_KEY_ID=
# 20:30 UTC = 02:00 IST. Backups also run at startup, with 15-minute failure retries.
BACKUP_HOUR_UTC=20
BACKUP_MINUTE_UTC=30
# Optional HTTPS receiver accepting a small JSON event; keep credential-bearing URLs private.
ALERT_WEBHOOK_URL=
# Readiness and backup-age checks; alert after consecutive failures.
MONITOR_INTERVAL_S=60
MONITOR_FAILURES=3
BACKUP_MAX_AGE_HOURS=26
