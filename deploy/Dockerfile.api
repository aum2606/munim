FROM python:3.12-slim
COPY --from=ghcr.io/astral-sh/uv:0.11.6 /uv /usr/local/bin/uv
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY backend/pyproject.toml backend/uv.lock ./
RUN uv sync --frozen --no-dev
COPY backend/ .
RUN groupadd --gid 10001 munim && useradd --uid 10001 --gid munim --no-create-home munim && mkdir -p /data/uploads && chown -R munim:munim /data/uploads
USER 10001:10001
CMD ["/app/.venv/bin/uvicorn","app.main:create_app","--factory","--host","0.0.0.0","--port","8000","--proxy-headers","--forwarded-allow-ips=*"]
