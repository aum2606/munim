# Copy to .env (never commit .env). Every variable the app reads is listed here.

# dev | test | prod. In prod, SECRET_KEY must be >= 32 chars and not a placeholder.
APP_ENV=dev
# Signs JWTs. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-secret-key-change-me-in-production
LOG_LEVEL=INFO

# Postgres (docker compose uses these for the postgres service and builds DATABASE_URL for api/worker).
POSTGRES_USER=munim
POSTGRES_PASSWORD=munim-dev-only
POSTGRES_DB=munim
DATABASE_URL=postgresql+asyncpg://munim:munim-dev-only@localhost:5432/munim

# Comma-separated browser origins allowed to call the API (empty = same-origin only).
CORS_ORIGINS=
# Set false on a public deployment after creating your owner account.
ALLOW_REGISTRATION=true
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# Rate limits (in this API process; see app/core/ratelimit.py): 10 logins a minute and 5
# registrations an hour per address, 300 calls a minute per business, 30 playground messages a
# minute, and a prober sending bad webhook signatures is shut out after 20 tries a minute.
RATE_LIMIT_ENABLED=true
# Behind a proxy the socket address is the proxy's. Name the header that carries the real client
# address (CF-Connecting-IP for a Cloudflare Tunnel) ONLY if your proxy always sets it; leave empty
# otherwise, because a client could forge any header you trust.
TRUSTED_PROXY_HEADER=
# Messages beyond this from one customer in 10 minutes are stored but not answered, so one chat
# cannot use up the free-tier model quota.
CUSTOMER_MESSAGES_PER_10_MIN=30

# LLM provider fallback chains, tried in order, first one that answers wins. An entry is
#   groq|<model>   openrouter|<model>   gemini|<model>   ollama|<model>
# (the base URL is built in), or name|https://base_url|model for any other OpenAI-compatible endpoint.
# Verify each provider's current free-tier limits and data-use terms before use (BUILD_PLAN.md section 3).
# Base URLs used (checked against each provider's docs on 2026-11-16):
#   Groq        https://api.groq.com/openai/v1
#   OpenRouter  https://openrouter.ai/api/v1            (free models have ":free" in their id; rate-limited)
#   Gemini      https://generativelanguage.googleapis.com/v1beta/openai
#   Ollama      http://localhost:11434/v1               (local, no key)
# Model names change often: list them from the provider (e.g. GET <base>/models) rather than trusting
# a name here. Free tiers rate-limit hard and some use your prompts to improve their products, so use
# a local model or a no-training provider for real customer data. Example:
#   LLM_SMALL_CHAIN=groq|<model>,gemini|<model>
#   LLM_LARGE_CHAIN=openrouter|<model>:free,groq|<model>
LLM_SMALL_CHAIN=
LLM_LARGE_CHAIN=
# One key per provider; the name in a chain entry picks the key. Never commit real keys.
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# For a provider not listed above, as name=key pairs matching its chain entry (optional).
LLM_API_KEYS=
LLM_TIMEOUT_S=30

# Worker
JOB_POLL_SECONDS=1.0
JOB_LEASE_SECONDS=120

# docker compose host ports (127.0.0.1 only). Change them if something else already uses the port.
POSTGRES_PORT=5432
API_PORT=8000
DASHBOARD_PORT=5173

# Embeddings run locally (fastembed, no API key). The model must output 384-dim vectors, which is
# what the database column is sized for; a different size needs a migration. Weights (~220 MB)
# download on first use; set a cache dir on a volume so they survive container restarts.
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_CACHE_DIR=

# Uploaded files (catalogues, documents). Mount a volume here in Docker.
STORAGE_DIR=./uploads
MAX_UPLOAD_MB=10

# Wait this long after a customer message so a burst of messages gets one reply.
DEBOUNCE_SECONDS=2.5
# Router confidence below this hands the conversation to a human.
ROUTER_CONFIDENCE_THRESHOLD=0.6

# Vector matches farther than this (cosine distance, 0 = identical, 2 = opposite) are ignored, so an
# unrelated question finds nothing and becomes a knowledge gap instead of a guess. Tune it with
# MunimBench; too low misses paraphrases, too high lets unrelated text through.
SEARCH_MAX_DISTANCE=0.65

# --- WhatsApp (Phase 3) -------------------------------------------------------------------------
# Channel credentials are encrypted in the database with this Fernet key. Required in prod; empty
# derives a key from SECRET_KEY, fine for local use. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing the key makes saved WhatsApp tokens unreadable (re-enter them in Settings).
CREDENTIALS_ENCRYPTION_KEY=
# One Meta app serves every business. Webhook callback URL: https://<your-host>/webhooks/whatsapp
# VERIFY_TOKEN is any random string you also type into Meta's webhook setup; APP_SECRET is the app's
# secret (App settings > Basic). With either empty the webhook refuses every request.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Graph API version, see https://developers.facebook.com/docs/graph-api/changelog
WHATSAPP_API_VERSION=v24.0
# Voice-note downloads send your WhatsApp token to the URL Meta returns, so only these domains (and
# subdomains) are accepted. Meta's docs show lookaside.fbsbx.com. Widen it only for a real Meta host.
WHATSAPP_MEDIA_HOSTS=fbsbx.com,whatsapp.net,fbcdn.net,facebook.com,whatsapp.com

# Voice notes are transcribed locally with faster-whisper (no API key). "small" handles Hindi and
# Gujarati reasonably on CPU; "base" is faster and less accurate, "medium" slower and better.
# Weights download on first use into STT_CACHE_DIR.
STT_MODEL=small
STT_DEVICE=cpu
STT_CACHE_DIR=
# Below this confidence the bot repeats what it heard and asks the customer to confirm.
STT_CONFIDENCE_THRESHOLD=0.6
MAX_VOICE_NOTE_MB=16

# Model calls one business may make per 24 hours (about three per customer message). Past it the
# assistant hands chats to a person, so one shop cannot use up the quota every shop shares. 0 = no limit.
DAILY_MODEL_CALLS_PER_BUSINESS=600

# Password-reset email. Any SMTP server works (several have free tiers). Leave SMTP_HOST empty to
# turn it off: the form still answers the same, but no mail is sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Where the dashboard is reached from outside: the reset link in the email starts with it.
PUBLIC_URL=http://localhost:8080

# A sent quote with no customer reply after this many days gets a follow-up draft for the owner.
FOLLOWUP_AFTER_DAYS=2
