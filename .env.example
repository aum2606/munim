# Copy to .env (never commit .env). Every variable the app reads is listed here.

# dev | test | prod. In prod, SECRET_KEY must be >= 32 chars and not a placeholder.
APP_ENV=dev
# Signs JWTs. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-secret-key-change-me-in-production
LOG_LEVEL=INFO

# Postgres (docker compose uses these for the postgres service and builds DATABASE_URL for api/worker).
POSTGRES_USER=munim
POSTGRES_PASSWORD=munim-dev-only
POSTGRES_DB=munim
DATABASE_URL=postgresql+asyncpg://munim:munim-dev-only@localhost:5432/munim

# Comma-separated browser origins allowed to call the API (empty = same-origin only).
CORS_ORIGINS=
# Set false on a public deployment after creating your owner account.
ALLOW_REGISTRATION=true
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# LLM provider fallback chains, tried in order. Each entry: name|base_url|model
# (any OpenAI-compatible endpoint, including a local Ollama at http://localhost:11434/v1).
# Verify each provider's current free-tier limits and data-use terms before use (BUILD_PLAN.md section 3).
LLM_SMALL_CHAIN=
LLM_LARGE_CHAIN=
# name=key pairs, comma-separated, matching the names above. Never commit real keys.
LLM_API_KEYS=
LLM_TIMEOUT_S=30

# Worker
JOB_POLL_SECONDS=1.0
JOB_LEASE_SECONDS=120

# docker compose host ports (127.0.0.1 only). Change them if something else already uses the port.
POSTGRES_PORT=5432
API_PORT=8000
DASHBOARD_PORT=5173
