# Runtime mode: dev, test, prod.
APP_ENV=dev
# Required JWT signing key; generate a unique random value of at least 32 characters.
SECRET_KEY=
# Local database; Compose overrides the hostname to postgres.
DATABASE_URL=postgresql+asyncpg://munim:munim@localhost:57432/munim
# Local queue/locks; Compose overrides the hostname to redis.
REDIS_URL=redis://localhost:56379/0
# Comma-separated trusted dashboard origins.
CORS_ORIGINS=http://localhost:5173
# Short-lived access JWT lifetime in minutes.
ACCESS_TOKEN_MINUTES=15
# Rotating refresh session lifetime in days.
REFRESH_TOKEN_DAYS=7
# No external model calls by default; opt in to openai_compatible explicitly.
LLM_PROVIDER=fake
# OpenAI-compatible API prefix (without /chat/completions).
LLM_BASE_URL=https://api.openai.com/v1
# Provider credential; never commit a real key.
LLM_API_KEY=
# Models for the three agent slots; set when enabling a live provider.
LLM_MODEL_ROUTER=
LLM_MODEL_REASONING=
LLM_MODEL_CHEAP=
# Provider HTTP timeout in seconds.
LLM_TIMEOUT_S=30
# fake is offline; openai_compatible uses LLM_BASE_URL and LLM_API_KEY for /embeddings.
EMBEDDING_PROVIDER=fake
# Hosted/local multilingual embedding model for a later phase.
EMBEDDING_MODEL=
# Must be 1024 for the current migration; changing dimensions requires migration and re-embedding.
EMBEDDING_DIM=1024
# Optional reranking; disabled in Phase 0.
RERANKER_ENABLED=false
# Local file storage directory.
STORAGE_DIR=uploads
# Fernet key for channel credentials; generate with make channel-key. Keep it stable and private.
CREDENTIALS_ENCRYPTION_KEY=
# Configure the same Meta app as the system-user access token used in the dashboard.
# Use a random verification token and the Meta app secret; never commit either value.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Choose a currently supported Graph version in Meta, formatted vNN.0; intentionally no guessed default.
WHATSAPP_API_VERSION=
# Message burst debounce and router confidence threshold (Phase 1).
DEBOUNCE_SECONDS=2.5
ROUTER_CONFIDENCE_THRESHOLD=0.6
# Vite dev proxy upstream; set to http://api:8000 inside Compose.
API_PROXY_TARGET=http://localhost:18000
# Explicit real-model eval opt-in; tests always use fakes. Real CLI requires a dedicated migrated DB.
EVAL_USE_REAL_LLM=0

# Anonymous web-chat bearer sessions expire after this many hours.
WIDGET_SESSION_HOURS=24
# Per-IP/tenant widget requests allowed each minute.
WIDGET_RATE_PER_MINUTE=60
# SSE connection lifetime; clients reconnect with their bearer token.
WIDGET_STREAM_SECONDS=60

# Public URL of the single-file widget bundle for owner installation snippets.
WIDGET_SCRIPT_URL=http://localhost:5174/widget.js
# Browser-reachable API origin used by embedded widgets (not the internal Compose URL).
PUBLIC_API_URL=http://localhost:18000

# Required only by make seed: choose a demo-owner password of at least 12 characters.
# Never use a production password; existing seeded owner passwords are preserved.
DEMO_SEED_PASSWORD=

# WhatsApp Graph request timeout in seconds; ambiguous send timeouts are not blindly retried.
WHATSAPP_TIMEOUT_S=20
# Maximum explicitly rejected/transient delivery attempts before dead-letter status.
WHATSAPP_MAX_ATTEMPTS=6

# Maximum authenticated WhatsApp attachment download size (bytes); default 8 MiB.
WHATSAPP_MAX_MEDIA_BYTES=8388608

# Dedicated, migrated non-production database for opt-in real-model evaluation only.
EVAL_DATABASE_URL=
# Optional JSON report destination; default is the ignored workspace .cache/evals/report.json.
# EVAL_REPORT_PATH=

# Bound all multipart/streamed request bodies before parsing (6 MiB default).
MAX_REQUEST_BYTES=6291456
# Smaller JSON limit; signed channel webhooks retain their separate 1 MiB cap.
MAX_JSON_BYTES=65536
# Abort slow request-body reads; excludes long-lived response/SSE time.
REQUEST_BODY_TIMEOUT_S=15
# Redis-backed auth, user and tenant limits. Keep enabled in production.
RATE_LIMITS_ENABLED=true
AUTH_RATE_PER_MINUTE=30
TENANT_RATE_PER_MINUTE=3000
USER_RATE_PER_MINUTE=600

# Stable HMAC key for erasure tombstones; separate from rotating JWT keys in production.
PRIVACY_HASH_KEY=

# Production compose variables (see .env.production.example; only web publishes ports).
APP_DOMAIN=
TLS_EMAIL=
POSTGRES_PASSWORD=
# Explicit isolated staging override only; live pilots must use configured real providers.
ALLOW_FAKE_MODELS_IN_PROD=false
# Private object storage, instance IAM role preferred. Never commit real credentials.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1
BACKUP_BUCKET=
BACKUP_PREFIX=munim
BACKUP_ENDPOINT_URL=
BACKUP_SSE=AES256
BACKUP_KMS_KEY_ID=
BACKUP_HOUR_UTC=20
BACKUP_MINUTE_UTC=30
BACKUP_WORK_DIR=/backups
BACKUP_STATE_DIR=/backup-state
UPLOADS_DIR=/data/uploads
# Internal readiness target; optional HTTPS JSON alert receiver. URLs may contain secrets.
HEALTH_URL=http://api:8000/ready
ALERT_WEBHOOK_URL=
MONITOR_INTERVAL_S=60
MONITOR_FAILURES=3
BACKUP_MAX_AGE_HOURS=26
