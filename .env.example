# Runtime mode: dev, test, prod.
APP_ENV=dev
# Required JWT signing key; generate a unique random value of at least 32 characters.
SECRET_KEY=
# Local database; Compose overrides the hostname to postgres.
DATABASE_URL=postgresql+asyncpg://munim:munim@localhost:57432/munim
# Local queue/locks; Compose overrides the hostname to redis.
REDIS_URL=redis://localhost:56379/0
# Comma-separated trusted dashboard origins.
CORS_ORIGINS=http://localhost:5173
# Short-lived access JWT lifetime in minutes.
ACCESS_TOKEN_MINUTES=15
# Rotating refresh session lifetime in days.
REFRESH_TOKEN_DAYS=7
# No external model calls by default; opt in to openai_compatible explicitly.
LLM_PROVIDER=fake
# OpenAI-compatible API prefix (without /chat/completions).
LLM_BASE_URL=https://api.openai.com/v1
# Provider credential; never commit a real key.
LLM_API_KEY=
# Models for the three agent slots; set when enabling a live provider.
LLM_MODEL_ROUTER=
LLM_MODEL_REASONING=
LLM_MODEL_CHEAP=
# Provider HTTP timeout in seconds.
LLM_TIMEOUT_S=30
# fake is offline; openai_compatible uses LLM_BASE_URL and LLM_API_KEY for /embeddings.
EMBEDDING_PROVIDER=fake
# Hosted/local multilingual embedding model for a later phase.
EMBEDDING_MODEL=
# Must be 1024 for the current migration; changing dimensions requires migration and re-embedding.
EMBEDDING_DIM=1024
# Optional reranking; disabled in Phase 0.
RERANKER_ENABLED=false
# Local file storage directory.
STORAGE_DIR=uploads
# Encryption key for channel credentials, required when channels are added.
CREDENTIALS_ENCRYPTION_KEY=
# Meta webhook verification token, app secret and API version (Phase 4).
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=
# Message burst debounce and router confidence threshold (Phase 1).
DEBOUNCE_SECONDS=2.5
ROUTER_CONFIDENCE_THRESHOLD=0.6
# Vite dev proxy upstream; set to http://api:8000 inside Compose.
API_PROXY_TARGET=http://localhost:18000
# Explicit real-model eval opt-in, only read by the future eval runner.
EVAL_USE_REAL_LLM=0

# Anonymous web-chat bearer sessions expire after this many hours.
WIDGET_SESSION_HOURS=24
# Per-IP/tenant widget requests allowed each minute.
WIDGET_RATE_PER_MINUTE=60
# SSE connection lifetime; clients reconnect with their bearer token.
WIDGET_STREAM_SECONDS=60

# Public URL of the single-file widget bundle for owner installation snippets.
WIDGET_SCRIPT_URL=http://localhost:5174/widget.js
# Browser-reachable API origin used by embedded widgets (not the internal Compose URL).
PUBLIC_API_URL=http://localhost:18000

# Required only by make seed: choose a demo-owner password of at least 12 characters.
# Never use a production password; existing seeded owner passwords are preserved.
DEMO_SEED_PASSWORD=
